{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "klms",
  "version": "1.0.0",
  "description": "Library Management System - Offline Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "build-electron": "npm run build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "db:init": "node database/scripts/init-db.js"
  },
  "keywords": [
    "library",
    "management",
    "electron",
    "offline",
    "sqlite"
  ],
  "author": "Dinuka Weerasinghe",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.8.0",
    "i18next": "^25.8.18",
    "lucide-react": "^0.564.0",
    "pdfkit": "^0.17.2",
    "react-i18next": "^16.5.8",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.klms.kumaradasa",
    "productName": "KLMS",
    "artifactName": "${productName}_v${version}_Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "electron/**/*",
      "database/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "electron/build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "guid": "KLMS-KUMARADASA-OFFLINE",
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
